# Copy this to backend/.env and fill in real values

# PostgreSQL connection string
# Local example: postgresql://postgres:postgres@localhost:5432/shothub
# Render/Railway/Supabase: paste the URL they give you
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shothub"

# JWT signing secret — generate a long random string for production
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET="change-me-to-a-long-random-string-in-production"

# Server port — also serves the frontend in single-origin mode
PORT=4000

# v3 single-origin: this server serves the built React app too (default true).
# Set to false only if you host the frontend separately.
SERVE_FRONTEND=true

# Where uploaded videos are stored (default: backend/uploads).
# Use an absolute path on a drive with enough space for video files.
# UPLOADS_DIR=/absolute/path/to/uploads

# CORS — not needed in single-origin mode (frontend served from this server).
# Only set this if SERVE_FRONTEND=false and the frontend runs on another origin.
CORS_ORIGIN="http://localhost:5173"

# Admin/seed defaults
SEED_ADMIN_EMAIL="admin@studio.local"
SEED_ADMIN_PASSWORD="admin123"
SEED_DEFAULT_PASSWORD="studio123"
