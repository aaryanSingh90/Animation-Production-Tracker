generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BOSS
  PRODUCTION_MANAGER
  COORDINATOR
  EMPLOYEE
}

enum EmploymentType {
  INHOUSE
  FREELANCE
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  ON_LEAVE
  OVERLOADED
}

enum TrackingMode {
  PROJECT
  SHOT
  ASSET
}

enum AssetType {
  CHARACTER
  PROP
  BG
  ENVIRONMENT
}

enum AssetSubCategory {
  CHARACTER
  CHARACTER_BLENDSHAPES
  PROP
  BG
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  REVISION_REQUIRED
  ISSUE
  EXTENDED
}

enum CharacterStageName {
  REFERENCE
  MODELLING
  BLENDSHAPES
  TEXTURING
  RIGGING
}

enum IssueType {
  TECHNICAL
  SOFTWARE_CRASH
  ASSET_MISSING
  HARDWARE_FAILURE
  ARTIST_UNAVAILABLE
  OTHER
}

enum NotificationType {
  APPROVAL_NEEDED
  APPROVED
  REJECTED
  DEADLINE_WARNING
  DEADLINE_MISSED
  ISSUE_LOGGED
  ASSIGNED
  COMMENT
}

enum CommentType {
  NOTE
  QUESTION
  FEEDBACK
  APPROVAL_NOTE
}

enum OverallStatus {
  ON_TRACK
  DELAYED
  COMPLETED
  HAS_ISSUES
}

model User {
  id                      Int                @id @default(autoincrement())
  name                    String
  email                   String             @unique
  password                String
  phone                   String?
  joinedAt                DateTime           @default(now())
  role                    Role
  departmentId            String?
  department              Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentName          String?
  teamId                  String?
  team                    Team?              @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  leadTeams               Team[]             @relation("TeamLead")
  employmentType          EmploymentType     @default(INHOUSE)
  availabilityStatus      AvailabilityStatus @default(AVAILABLE)
  skills                  String[]           @default([])
  isActive                Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  assignedProjectStages   ProjectStage[]     @relation("UserProjectStages")
  stageAssignments        StageAssignment[]
  assignedCharacterStages CharacterStage[]   @relation("UserCharacterStages")
  assignedShotStages      ShotStage[]        @relation("UserShotStages")
  assignedAssetStages     AssetStage[]       @relation("UserAssetStages")
  teamProjectAssignments  TeamProject[]      @relation("TeamProjectAssigner")
  shotStageComments       ShotStageComment[]
  assetStageComments      AssetStageComment[]
  loggedIssues            IssueLog[]
  notifications           Notification[]
  activityLogs            ActivityLog[]
  stageComments           StageComment[]     @relation("CommentAuthor")
}

model Client {
  id          Int       @id @default(autoincrement())
  name        String
  companyName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

model Project {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  client            String?
  clientId          Int?
  clientRef         Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  description       String?
  priority          Int
  audioReceivedDate DateTime
  startDate         DateTime?
  dueDate           DateTime?
  totalShots        Int                @default(0)
  activeStageCodes  String[]           @default([])
  lightingMode      TrackingMode       @default(PROJECT)
  renderingMode     TrackingMode       @default(PROJECT)
  overallStatus     OverallStatus      @default(ON_TRACK)
  progressPercent   Float              @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  stages            ProjectStage[]
  shots             Shot[]
  assets            Asset[]
  projectCharacters ProjectCharacter[]
  teamProjects      TeamProject[]
  notifications     Notification[]
  activityLogs      ActivityLog[]

  @@index([clientId])
}

model ProjectStage {
  id                    Int                         @id @default(autoincrement())
  projectId             Int
  stageName             String
  trackingMode          TrackingMode                @default(PROJECT)
  stageTemplateId       String?
  stageTemplate         StageTemplate?              @relation(fields: [stageTemplateId], references: [id], onDelete: SetNull)
  stageDefinitionId     String?
  stageDefinition       StageDefinition?            @relation(fields: [stageDefinitionId], references: [id], onDelete: SetNull)
  customName            String?
  order                 Int                         @default(0)
  departmentName        String?
  status                StageStatus                 @default(NOT_STARTED)
  startDate             DateTime?
  endDate               DateTime?
  actualStartedAt       DateTime?
  actualDoneAt          DateTime?
  timeConsumedMin       Int?
  deadline              DateTime?
  assignedUserId        Int?
  submittedAt           DateTime?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  notes                 String?
  feedback              String?
  audioStatus           StageStatus?
  finalOutput           String?
  isActive              Boolean                     @default(true)
  isDeadlineMissed      Boolean                     @default(false)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  project               Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedUser          User?                       @relation("UserProjectStages", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignments           StageAssignment[]
  departmentAssignments StageDepartmentAssignment[]
  issueLogs             IssueLog[]
  notifications         Notification[]
  activityLogs          ActivityLog[]
  comments              StageComment[]

  @@unique([projectId, stageName, customName])
  @@index([projectId, order])
  @@index([projectId, isActive])
  @@index([stageDefinitionId])
}

model Character {
  id           Int                @id @default(autoincrement())
  name         String             @unique
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  stages       CharacterStage[]
  projectLinks ProjectCharacter[]
}

model CharacterStage {
  id             Int                @id @default(autoincrement())
  characterId    Int
  stageName      CharacterStageName
  status         StageStatus        @default(NOT_STARTED)
  deadline       DateTime?
  assignedUserId Int?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  character      Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  assignedUser   User?              @relation("UserCharacterStages", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@unique([characterId, stageName])
}

model ProjectCharacter {
  id          Int       @id @default(autoincrement())
  projectId   Int
  characterId Int
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([projectId, characterId])
}

model IssueLog {
  id               Int          @id @default(autoincrement())
  projectStageId   Int
  issueType        IssueType
  description      String
  originalDeadline DateTime?
  newDeadline      DateTime?
  extensionReason  String?
  loggedById       Int
  createdAt        DateTime     @default(now())
  projectStage     ProjectStage @relation(fields: [projectStageId], references: [id], onDelete: Cascade)
  loggedBy         User         @relation(fields: [loggedById], references: [id])
}

model Notification {
  id               Int              @id @default(autoincrement())
  userId           Int
  message          String
  type             NotificationType
  isRead           Boolean          @default(false)
  relatedProjectId Int?
  relatedStageId   Int?
  createdAt        DateTime         @default(now())
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedProject   Project?         @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)
  relatedStage     ProjectStage?    @relation(fields: [relatedStageId], references: [id], onDelete: SetNull)
}

model ActivityLog {
  id        Int           @id @default(autoincrement())
  projectId Int
  stageId   Int?
  actorId   Int?
  eventType String
  message   String
  createdAt DateTime      @default(now())
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     ProjectStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  actor     User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model StageAssignment {
  id             String       @id @default(cuid())
  projectStageId Int
  projectStage   ProjectStage @relation(fields: [projectStageId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([projectStageId, userId])
}

model Department {
  id               String                      @id @default(cuid())
  name             String                      @unique
  description      String?
  color            String?                     @default("#10B981")
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  employees        User[]
  teams            Team[]
  stageAssignments StageDepartmentAssignment[]
}

model Team {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  color        String?       @default("#3B82F6")
  departmentId String?
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leadId       Int?
  lead         User?         @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  isArchived   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  members      User[]        @relation("TeamMembers")
  projects     TeamProject[]

  @@index([departmentId])
  @@index([leadId])
}

model TeamProject {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projectId    Int
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedById Int?
  assignedBy   User?    @relation("TeamProjectAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@unique([teamId, projectId])
  @@index([projectId])
}

model StageDepartmentAssignment {
  id             String       @id @default(cuid())
  projectStageId Int
  projectStage   ProjectStage @relation(fields: [projectStageId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assignedAt     DateTime     @default(now())

  @@unique([projectStageId, departmentId])
}

model StageTemplate {
  id              String         @id @default(cuid())
  name            String         @unique
  legacyStageName String?
  color           String?
  createdAt       DateTime       @default(now())
  projectStages   ProjectStage[]
}

model StageDefinition {
  id               String       @id @default(cuid())
  name             String
  code             String       @unique
  trackingMode     TrackingMode
  isHybrid         Boolean      @default(false)
  requiresApproval Boolean      @default(true)
  order            Int
  color            String?
  icon             String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  projectStages    ProjectStage[]
  shotStages       ShotStage[]
  assetStages      AssetStage[]

  @@index([trackingMode, order])
}

model Shot {
  id          String      @id @default(cuid())
  projectId   Int
  shotNumber  Int
  label       String?
  frameStart  Int         @default(101)
  frameEnd    Int?
  seconds     Float?
  name        String?
  description String?
  duration    Float?
  order       Int
  status      StageStatus @default(NOT_STARTED)
  audioStatus StageStatus?
  finalOutput String?
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stages      ShotStage[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([projectId, shotNumber])
  @@index([projectId, order])
}

model ShotStage {
  id                String          @id @default(cuid())
  shotId            String
  stageDefinitionId String
  assignedUserId    Int?
  status            StageStatus     @default(NOT_STARTED)
  startDate         DateTime?
  endDate           DateTime?
  actualStartedAt   DateTime?
  actualDoneAt      DateTime?
  timeConsumedMin   Int?
  deadline          DateTime?
  submittedAt       DateTime?
  approvedAt        DateTime?
  notes             String?
  feedback          String?
  shot              Shot            @relation(fields: [shotId], references: [id], onDelete: Cascade)
  stageDefinition   StageDefinition @relation(fields: [stageDefinitionId], references: [id], onDelete: Cascade)
  assignedUser      User?           @relation("UserShotStages", fields: [assignedUserId], references: [id], onDelete: SetNull)
  comments          ShotStageComment[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([shotId, stageDefinitionId])
  @@index([assignedUserId])
  @@index([stageDefinitionId, status])
}

model Asset {
  id                String      @id @default(cuid())
  projectId         Int
  name              String
  type              AssetType
  subCategory       AssetSubCategory?
  description       String?
  referenceImageUrl String?
  order             Int         @default(0)
  status            StageStatus @default(NOT_STARTED)
  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stages            AssetStage[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([projectId, type])
}

model AssetStage {
  id                String          @id @default(cuid())
  assetId           String
  stageDefinitionId String
  assignedUserId    Int?
  status            StageStatus     @default(NOT_STARTED)
  startDate         DateTime?
  endDate           DateTime?
  actualStartedAt   DateTime?
  actualDoneAt      DateTime?
  timeConsumedMin   Int?
  deadline          DateTime?
  submittedAt       DateTime?
  approvedAt        DateTime?
  notes             String?
  feedback          String?
  asset             Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  stageDefinition   StageDefinition @relation(fields: [stageDefinitionId], references: [id], onDelete: Cascade)
  assignedUser      User?           @relation("UserAssetStages", fields: [assignedUserId], references: [id], onDelete: SetNull)
  comments          AssetStageComment[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([assetId, stageDefinitionId])
  @@index([assignedUserId])
  @@index([stageDefinitionId, status])
}

model ShotStageComment {
  id         String             @id @default(cuid())
  shotStageId String
  shotStage  ShotStage          @relation(fields: [shotStageId], references: [id], onDelete: Cascade)
  authorId   Int
  author     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  type       CommentType        @default(NOTE)
  parentId   String?
  parent     ShotStageComment?  @relation("ShotCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    ShotStageComment[] @relation("ShotCommentReplies")
  isEdited   Boolean            @default(false)
  isInternal Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([shotStageId, createdAt])
  @@index([authorId])
}

model AssetStageComment {
  id          String              @id @default(cuid())
  assetStageId String
  assetStage  AssetStage          @relation(fields: [assetStageId], references: [id], onDelete: Cascade)
  authorId    Int
  author      User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  type        CommentType         @default(NOTE)
  parentId    String?
  parent      AssetStageComment?  @relation("AssetCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     AssetStageComment[] @relation("AssetCommentReplies")
  isEdited    Boolean             @default(false)
  isInternal  Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([assetStageId, createdAt])
  @@index([authorId])
}

model StageComment {
  id                String         @id @default(cuid())
  projectStageId    Int
  projectStage      ProjectStage   @relation(fields: [projectStageId], references: [id], onDelete: Cascade)
  authorId          Int
  author            User           @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body              String
  type              CommentType    @default(NOTE)
  parentId          String?
  parent            StageComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies           StageComment[] @relation("CommentReplies")
  isEdited          Boolean        @default(false)
  isSystemGenerated Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([projectStageId, createdAt])
  @@index([authorId])
  @@index([parentId])
}
